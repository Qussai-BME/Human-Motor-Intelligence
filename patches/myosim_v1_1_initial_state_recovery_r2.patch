 @dataclass(frozen=True, slots=True)
+class InitialStatePerturbationConfig:
+    """Explicit, seed-linked initial-state distribution for declared repeat studies.
+
+    The default is inert so historical deterministic configurations retain their
+    original physics path. The only supported R2 distribution is a bounded
+    initial forearm-slider displacement; it neither changes task geometry nor
+    controller/decoder parameters.
+    """
+
+    enabled: bool = False
+    distribution_id: str = "none"
+    forearm_x_offset_range_m: tuple[float, float] = (0.0, 0.0)
+    forearm_y_offset_range_m: tuple[float, float] = (0.0, 0.0)
+
+    def __post_init__(self) -> None:
+        ranges = (self.forearm_x_offset_range_m, self.forearm_y_offset_range_m)
+        for value in ranges:
+            if not isinstance(value, (tuple, list)) or len(value) != 2:
+                raise ValueError("initial-state offset ranges must contain exactly two values")
+            low, high = float(value[0]), float(value[1])
+            if not np.isfinite(low) or not np.isfinite(high) or low > high:
+                raise ValueError("initial-state offset ranges must be finite and ordered")
+        if self.enabled:
+            if self.distribution_id != "uniform_forearm_xy_v1":
+                raise ValueError("enabled initial-state perturbation requires distribution_id='uniform_forearm_xy_v1'")
+            x_low, x_high = (float(value) for value in self.forearm_x_offset_range_m)
+            y_low, y_high = (float(value) for value in self.forearm_y_offset_range_m)
+            if x_low < 0.0 or x_high > 0.020 or y_low < -0.015 or y_high > 0.015:
+                raise ValueError("initial-state perturbation exceeds the declared R2 safety envelope")
+        elif self.distribution_id != "none" or any(float(item) != 0.0 for pair in ranges for item in pair):
+            raise ValueError("disabled initial-state perturbation must use distribution_id='none' and zero ranges")
+
+
